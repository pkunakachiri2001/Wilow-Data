# .env.example — Copy this to .env and fill in your values
# Never commit .env to git!

# Neon PostgreSQL connection string
# Get this from: https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://user:password@ep-xxxxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Cloud server URL (Render deployment)
# Fill this in once your Render app is deployed
CLOUD_SERVER_URL=https://your-app-name.onrender.com/upload

# Local server URL for RPi client (your laptop's LAN IP)
LOCAL_SERVER_URL=http://192.168.1.XXX:5002/upload

# Optional: Flask secret key (auto-generated by Render in cloud, set manually here if needed)
# SECRET_KEY=change-me-to-a-random-string
