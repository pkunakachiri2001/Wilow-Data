# .env.example — Copy this to .env and fill in your values
# Never commit .env to git!

# Shared Neon PostgreSQL connection string (used by both cloud_server.py and local server.py)
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@YOUR-ENDPOINT-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Optional: Flask session secret key
# SECRET_KEY=change-me-to-a-random-string

# Optional: Shared API key for protecting /data POST endpoint
# ESP32_API_KEY=change-me-to-a-shared-api-key

# Optional (local server.py): Forward raw CSV uploads directly to cloud /upload endpoint
# FORWARD_URL=https://your-render-app.onrender.com/upload

# Optional (local server.py): Minutes of recent data kept in Neon for live cloud charts (default: 60)
# DB_RETENTION_MINUTES=60

# Optional (local server.py): Days to keep raw uploaded CSVs in uploads/ before pruning (default: 7)
# UPLOAD_RETENTION_DAYS=7

# Optional (local server.py): Direct Raspberry Pi HTTP pull URL if Neon buffer overflowed
# RPI_CLIENT_URL=http://192.168.1.50:5000
