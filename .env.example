# .env.example — Copy this to .env and fill in your values
# Never commit .env to git!

# Aiven PostgreSQL connection string
# Get this from: https://console.aiven.io -> your PostgreSQL service -> Overview -> Service URI
DATABASE_URL=postgres://avnadmin:YOUR_AIVEN_PASSWORD@YOUR-SERVICE-NAME-YOUR-PROJECT.aivencloud.com:12345/defaultdb?sslmode=require

# Optional: Flask secret key (set manually here if needed)
# SECRET_KEY=change-me-to-a-random-string
